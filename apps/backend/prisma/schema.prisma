// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String? // Nullable для пользователей через OAuth
  phone    String? @unique
  district String? // Округ пользователя
  balance  Int     @default(0) // Баланс токенов

  isRepresentative Boolean @default(false)
  role             Role    @default(USER)

  // OAuth провайдеры
  gosuslugiId String? @unique
  sberId      String? @unique
  tinkoffId   String? @unique

  // Верифицирован и активная учтеная запись
  isVerified Boolean   @default(false)
  isActive   Boolean   @default(true)
  deletedAt  DateTime?

  tokens Token[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связь 1-1 с профилем представителя
  representativeProfile RepresentativeProfile?

  // Связь с заданиями
  tasks        Task[]
  taskComments TaskComment[]

  @@map("users")
}

// Профиль представителя власти
model RepresentativeProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  position String // "Депутат городской думы", "Глава района"
  party    String? // Политическая партия

  rating         Float     @default(0.0)
  tasksTotal     Int       @default(0)
  tasksCompleted Int       @default(0)
  attendance     Float     @default(0.0) // Посещаемость в процентах
  lastActivity   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("representative_profiles")
}

// Токены для аутентификации и верификации
model Token {
  id          String    @id @default(cuid())
  userId      String
  type        TokenType
  hashedToken String    @unique
  device      String?
  ip          String?
  exp         DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

// Задание
model Task {
  id                    String    @id @default(cuid())
  title                 String
  address               String
  problemDescription    String
  possibleSolutions     String?
  desiredResolutionDate DateTime?

  //  Автор задания
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stages TaskStage[] // Этапы решения
  status TaskStatus  @default(DELIVERED) // Статус задания

  likesCount Int           @default(0) // Количество лайков
  viewsCount Int           @default(0) // Количество просмотров
  comments   TaskComment[] //  комментарии

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  taskFiles TaskFile[]

  @@map("tasks")
}

// Этапе заданий
model TaskStage {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  date      DateTime
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("task_stages")
}

// Файлы для задания
model TaskFile {
  id     String  @id @default(cuid())
  taskId String
  url    String // Ссылка на файл (например, S3, Supabase, CDN)
  name   String? // Опциональное название файла
  type   String? // MIME-тип (например "image/png", "application/pdf")
  size   Int? // Размер файла в байтах (опционально)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("task_files")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String // кто оставил комментарий
  text      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  REFRESH
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum TaskStatus {
  DELIVERED // "Доставлено"
  PLANNED // "Запланировано"
  IN_PROGRESS // "В процессе"  
  COMPLETED // "Выполнено"
  REJECTED // "Отклонено"
}
