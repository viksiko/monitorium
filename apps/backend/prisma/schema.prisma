// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  password   String? // Nullable для пользователей через OAuth
  phone      String?   @unique
  district   District? @relation(fields: [districtId], references: [id])
  districtId String?

  role Role

  // OAuth провайдеры
  gosuslugiId String? @unique
  sberId      String? @unique
  tinkoffId   String? @unique

  // Верифицирован и активная учтеная запись
  isRepresentative Boolean   @default(false)
  isVerified       Boolean   @default(false)
  isActive         Boolean   @default(false)
  deletedAt        DateTime?

  tokens Token[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связь 1-1 с профилем избирателя и представителя
  voterProfile          VoterProfile?
  representativeProfile RepresentativeProfile?

  // Созданные задачи
  authoredTasks Task[] @relation("AuthoredTasks")

  // Назначенные задачи
  assignedTasks Task[] @relation("AssignedTasks")

  // Я подписался
  subscriptions Subscription[] @relation("UserSubscriptions")

  // На меня подписались
  subscribers Subscription[] @relation("UserSubscribers")

  // Связь с постами
  posts Post[]

  // Связь с комментариями
  comments Comment[]

  voterDialogs          Dialog[]             @relation("VoterDialogs")
  representativeDialogs Dialog[]             @relation("RepresentativeDialogs")
  messages              Message[]
  balanceTransactions   BalanceTransaction[]
  notifications         Notification[]

  @@map("users")
}

// Задание
model Task {
  id    String @id @default(cuid())
  title String

  address               String
  problemDescription    String
  possibleSolutions     String?
  desiredResolutionDate DateTime?

  district   District @relation(fields: [districtId], references: [id]) // ← фиксируем округ на момент создания (берется от представителя при создании)
  districtId String

  // Автор задачи
  authorId String
  author   User   @relation("AuthoredTasks", fields: [authorId], references: [id])

  // Исполнитель / адресат
  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])

  stages TaskStage[] // Этапы решения
  status TaskStatus  @default(PLANNED) // Статус задания

  likesCount Int @default(0) // Количество лайков
  viewsCount Int @default(0) // Количество просмотров

  comments Comment[] //  комментарии

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  taskFiles     TaskFile[]
  notifications Notification[]

  @@map("tasks")
}

// Этапе заданий
model TaskStage {
  id          String   @id @default(cuid())
  taskId      String
  title       String
  date        DateTime
  isCompleted Boolean  @default(false)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("task_stages")
}

// Профиль для избирателя
model VoterProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Здесь можно хранить дополнительные данные о пользователе
  balance Int @default(0) // По умолчанию баланс 0, 10 начисляется автоматом при подтверждении регистрации

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("voter_profiles")
}

// Профиль представителя власти
model RepresentativeProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  position String // "Депутат городской думы", "Глава района"
  party    String? // Политическая партия
  bio      String? // О себе

  rating         Float     @default(0.0)
  tasksTotal     Int       @default(0)
  tasksCompleted Int       @default(0)
  attendance     Float     @default(0.0) // Посещаемость в процентах
  lastActivity   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("representative_profiles")
}

// Таблица для подписок
model Subscription {
  id String @id @default(cuid())

  subscriberId String
  subscriber   User   @relation("UserSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)

  representativeId String
  representative   User   @relation("UserSubscribers", fields: [representativeId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  notifications Notification[]

  @@unique([subscriberId, representativeId])
  @@map("subscriptions")
}

// Токены для аутентификации и верификации
model Token {
  id          String    @id @default(cuid())
  userId      String
  type        TokenType
  hashedToken String    @unique
  device      String?
  ip          String?
  exp         DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

// Файлы для задания
model TaskFile {
  id     String  @id @default(cuid())
  taskId String
  url    String // Ссылка на файл (например, S3, Supabase, CDN)
  name   String? // Опциональное название файла
  type   String? // MIME-тип (например "image/png", "application/pdf")
  size   Int? // Размер файла в байтах (опционально)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("task_files")
}

// таблица для постов
model Post {
  id          String   @id @default(cuid())
  title       String
  content     String // текст публикации
  publishedAt DateTime @default(now()) // дата публикации

  // Автор (представитель власти)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Файлы блога
  files PostFile[]

  likesCount Int       @default(0) // Количество лайков
  viewsCount Int       @default(0) // Количество просмотров
  comments   Comment[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@map("posts")
}

// для файлов в блоге
model PostFile {
  id     String  @id @default(cuid())
  postId String
  url    String // ссылка на файл (S3, CDN и т.п.)
  name   String?
  type   String? // MIME-тип
  size   Int? // размер в байтах

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("post_files")
}

model Comment {
  id      String @id @default(cuid())
  content String

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([taskId])
  @@map("comments")
}

model Dialog {
  id String @id @default(cuid())

  voterId String
  voter   User   @relation("VoterDialogs", fields: [voterId], references: [id], onDelete: Cascade)

  representativeId String
  representative   User   @relation("RepresentativeDialogs", fields: [representativeId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  voterLastReadAt          DateTime?
  representativeLastReadAt DateTime?

  @@unique([voterId, representativeId])
  @@map("dialogs")
}

model Message {
  id String @id @default(cuid())

  dialogId String
  dialog   Dialog @relation(fields: [dialogId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  text String

  createdAt DateTime @default(now())

  @@index([dialogId, createdAt])
  @@map("messages")
}

model District {
  id   String @id @default(cuid())
  name String @unique

  mapId Int @unique // ID из Яндекс.Карты

  areas Area[] // Один округ → много городов

  users User[] // Связь с пользователями (если используешь district у User)

  tasks Task[] // Связь задачами

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("districts")
}

model Area {
  id         String @id @default(cuid())
  name       String
  districtId String

  // Связь с округом
  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([name, districtId]) // чтобы не было одинаковых городов в одном округе
  @@map("areas")
}

model BalanceTransaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Тип операции
  type BalanceTransactionType

  // Сколько изменилось
  amount Int

  // Баланс ПОСЛЕ операции (очень важно!)
  balanceAfter Int

  // Направление (можно не хранить отдельно, но удобно)
  direction TransactionDirection

  // Доп. описание (например: "Создание задания #123")
  description String?

  // Связь с сущностью (опционально, но ОЧЕНЬ полезно)
  taskId    String?
  messageId String?

  createdAt DateTime @default(now())

  @@map("balance_transactions")
}

model Notification {
  id String @id @default(cuid())

  // Кому пришло уведомление
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Тип уведомления
  type NotificationType

  // Прочитано / нет
  isRead Boolean @default(false)

  // Доп. данные (универсально)
  title   String?
  message String?

  // связь с подписками
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  // связь с заданиями
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  // связь с постами
  postId String?
  post   Post?   @relation(fields: [postId], references: [id])

  // Связи с сущностями (опциональные)
  commentId String?
  messageId String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum Role {
  VOTER
  REPRESENTATIVE
  ADMIN
}

enum TokenType {
  REFRESH
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum TaskStatus {
  PLANNED // "Запланировано"
  IN_PROGRESS // "В процессе"  
  COMPLETED // "Выполнено"
  REJECTED // "Отклонено"
}

enum BalanceTransactionType {
  REGISTRATION_BONUS // начисление при регистрации  
  WATCH_AD // пополнение при просомотре рекламы
  REPRESENTATIVE_SUBSCRIPTION // пополнение за подписку на представителя власти
  CREATE_TASK // списание при создании задания
  MESSAGE_REPRESENTATIVE // списание при отправки сообщения
  PURCHASE_TICKETS // пополнение при покупке билетов (начисление)
}

enum TransactionDirection {
  CREDIT // пополнение
  DEBIT // списание
}

enum NotificationType {
  NEW_SUBSCRIBER // Новый подписчик (представителю → кто-то подписался)
  NEW_TASK_ASSIGNED // Назначено задание (представителю → новая задача)
  TASK_STATUS_CHANGED // Статус задания изменён (избирателю → обновление по задаче)
  NEW_POST // Новая публикация (избирателю → обновление по публикациям)
  NEW_COMMENT // Новый комментарий (автору публикации → кто-то прокомментировал)
  NEW_MESSAGE // Новое сообщение (пользователю → личное сообщение в чате)
}
