// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String? // Nullable для пользователей через OAuth
  phone    String? @unique
  district String? // Округ пользователя

  role Role

  // OAuth провайдеры
  gosuslugiId String? @unique
  sberId      String? @unique
  tinkoffId   String? @unique

  // Верифицирован и активная учтеная запись
  isRepresentative Boolean   @default(false)
  isVerified       Boolean   @default(false)
  isActive         Boolean   @default(true)
  deletedAt        DateTime?

  tokens Token[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связь 1-1 с профилем избирателя и представителя
  voterProfile          VoterProfile?
  representativeProfile RepresentativeProfile?

  // Связь с заданиями
  taskComments TaskComment[]

  // 📝 Созданные задачи
  authoredTasks Task[] @relation("AuthoredTasks")

  // 📥 Назначенные задачи
  assignedTasks Task[] @relation("AssignedTasks")

  tasks Task[]

  // 🔔 Я подписался
  subscriptions Subscription[] @relation("UserSubscriptions")

  // 👥 На меня подписались
  subscribers Subscription[] @relation("UserSubscribers")

  @@map("users")
}

// Задание
model Task {
  id                    String    @id @default(cuid())
  title                 String
  address               String
  problemDescription    String
  possibleSolutions     String?
  desiredResolutionDate DateTime?

  // Автор задачи
  authorId String
  author   User   @relation("AuthoredTasks", fields: [authorId], references: [id])

  // Исполнитель / адресат
  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])

  stages TaskStage[] // Этапы решения
  status TaskStatus  @default(PLANNED) // Статус задания

  likesCount Int           @default(0) // Количество лайков
  viewsCount Int           @default(0) // Количество просмотров
  comments   TaskComment[] //  комментарии

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  taskFiles TaskFile[]
  user      User?      @relation(fields: [userId], references: [id])
  userId    String?

  @@map("tasks")
}

// Этапе заданий
model TaskStage {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  date      DateTime
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("task_stages")
}

// Профиль для избирателя
model VoterProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Здесь можно хранить дополнительные данные о пользователе
  balance Int @default(0) // Баланс токенов

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("voter_profiles")
}

// Профиль представителя власти
model RepresentativeProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  position String // "Депутат городской думы", "Глава района"
  party    String? // Политическая партия
  bio      String? // О себе

  rating         Float     @default(0.0)
  tasksTotal     Int       @default(0)
  tasksCompleted Int       @default(0)
  attendance     Float     @default(0.0) // Посещаемость в процентах
  lastActivity   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("representative_profiles")
}

// Таблица для подписок
model Subscription {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())

  subscriberId String
  subscriber   User   @relation("UserSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)

  representativeId String
  representative   User   @relation("UserSubscribers", fields: [representativeId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, representativeId])
  @@map("subscriptions")
}

// Токены для аутентификации и верификации
model Token {
  id          String    @id @default(cuid())
  userId      String
  type        TokenType
  hashedToken String    @unique
  device      String?
  ip          String?
  exp         DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

// Файлы для задания
model TaskFile {
  id     String  @id @default(cuid())
  taskId String
  url    String // Ссылка на файл (например, S3, Supabase, CDN)
  name   String? // Опциональное название файла
  type   String? // MIME-тип (например "image/png", "application/pdf")
  size   Int? // Размер файла в байтах (опционально)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("task_files")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String // кто оставил комментарий
  text      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

enum Role {
  VOTER
  REPRESENTATIVE
  ADMIN
}

enum TokenType {
  REFRESH
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum TaskStatus {
  PLANNED // "Запланировано"
  IN_PROGRESS // "В процессе"  
  COMPLETED // "Выполнено"
  REJECTED // "Отклонено"
}
