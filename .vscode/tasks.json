{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start backend (docker)",
      "type": "shell",
      "command": "docker-compose up -d backend postgres",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Start backend (docker, build)",
      "type": "shell",
      "command": "docker-compose up --build -d backend postgres",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Start frontend",
      "type": "shell",
      "command": "npm run dev:front",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Start app",
      "dependsOn": ["Start backend (docker)", "Start frontend"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Start app (first run)",
      "dependsOn": ["Start backend (docker, build)", "Start frontend"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
