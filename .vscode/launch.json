{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Back",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": ["start", "--watch"],
      "runtimeArgs": ["-r", "${workspaceFolder}/.vscode/dotenv-loader.js"],
      "cwd": "${workspaceFolder}/apps/backend",
      "console": "integratedTerminal",
      "preLaunchTask": "types:watch"
    },
    {
      "name": "Front",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "runtimeArgs": ["-r", "${workspaceFolder}/.vscode/dotenv-loader.js"],
      "cwd": "${workspaceFolder}/apps/frontend",
      "console": "integratedTerminal",
      "preLaunchTask": "types:watch"
    }
  ],
  "compounds": [
    {
      "name": "Full",
      "configurations": ["Back", "Front"],
      "preLaunchTask": "types:watch",
      "stopAll": true
    }
  ]
}
