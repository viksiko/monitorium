{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Back",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": ["start", "--watch", "--debug"],
      "runtimeArgs": ["-r", "${workspaceFolder}/.vscode/dotenv-loader.js"],
      "cwd": "${workspaceFolder}/apps/backend",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "preLaunchTask": "types:watch"
    },
    {
      "name": "Front",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/apps/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/*": "${workspaceFolder}/apps/frontend/*"
      },
      "preLaunchTask": "vite:dev"
    }
  ],
  "compounds": [
    {
      "name": "Full",
      "configurations": ["Back", "Front"],
      "preLaunchTask": "types:watch",
      "stopAll": true
    }
  ]
}
