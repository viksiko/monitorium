ENVIRONMENT="developer"

API_PORT=0000 # <- ЗАМЕНИТЬ, порт backend-сервера
API_URL="http://localhost:${API_PORT}"
VITE_API_PORT=${API_PORT}
VITE_FRONTEND_PORT=0000 # <- ЗАМЕНИТЬ, порт сервера фронтенд разработки
VITE_FRONTEND_URL="http://localhost:${VITE_FRONTEND_PORT}"
VITE_BACKEND_HOST="http://host.docker.internal:${API_PORT}"
ALLOWED_ORIGINS="http://localhost:${VITE_FRONTEND_PORT}"
NGINX_PORT=80

POSTGRES_HOST="postgres" # <- ВАЖНО!!! Для фронтенд разработки или запуска приложения целиков в докере - postgres, для бэкэнд разработки - localhost
POSTGRES_HOST_PORT=0000  # <- ЗАМЕНИТЬ, порт доступа к БД на хост-машине
POSTGRES_DOCKER_PORT=0000 # <- ЗАМЕНИТЬ, порт доступа к БД в докере
POSTGRES_DB="dbname" # <- ЗАМЕНИТЬ, название БД
POSTGRES_USER="username" # <- ЗАМЕНИТЬ, пользователя БД
POSTGRES_PASSWORD="Abc123" # <- ЗАМЕНИТЬ, пароль пользователя БД
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_DOCKER_PORT}/${POSTGRES_DB}" # <- ВАЖНО!!! Для фронтенд разработки или запуска приложения целиков в докере - ${POSTGRES_DOCKER_PORT}, для бэкэнд разработки - ${POSTGRES_HOST_PORT}

JWT_ACCESS_SECRET="jwt_access_secret" # <- ЗАМЕНИТЬ,  cгенерируйте случайный ключ
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="jwt_refresh_secret" # <- ЗАМЕНИТЬ,  cгенерируйте случайный ключ
JWT_REFRESH_EXPIRES="30d"
JWT_REFRESH_SALT="jwt_refresh_salt" # <- ЗАМЕНИТЬ,  cгенерируйте случайный ключ
JWT_VERIFY_SALT="jwt_verify_salt" # <- ЗАМЕНИТЬ,  cгенерируйте случайный ключ
JWT_RESET_PASSWORD_SALT="jwt_reset_password" # <- ЗАМЕНИТЬ,  cгенерируйте случайный ключ

EMAIL_HOST="smtp.mail.ru" # <- ЗАМЕНИТЬ,
EMAIL_PORT=465 # <- ЗАМЕНИТЬ,
EMAIL_USER="user@mail.ru" # <- ЗАМЕНИТЬ,
EMAIL_PASSWORD="Abc123" # <- ЗАМЕНИТЬ,

VITE_API_MAP_YANDEX_KEY="api_map_yandex_key"