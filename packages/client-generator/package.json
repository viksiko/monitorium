{
    "name": "@monorepo/client-generator",
    "version": "1.0.0",
    "private": true,
    "description": "Генерация типизированного HTTP-клиента по NestJS контроллерам (AST, ts-morph)",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "generate-nest-client": "./dist/cli.js"
    },
    "files": ["dist"],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "generate": "npm run build && node dist/cli.js"
    },
    "dependencies": {
        "ts-morph": "^25.0.1",
        "typescript": "^5.5.3"
    },
    "devDependencies": {
        "@types/node": "^22.5.5"
    }
}
